{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/coconut",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/coconut/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/coconut/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
